# Marathi translation of the Shani OS installer configuration.
msgid ""
msgstr ""
"Project-Id-Version: os-installer-config\n"
"Language: mr\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid ""
"Welcome to Shani OS!\n"
"\n"
"An Immutable OS for Ultimate Reliability\n"
"\n"
"This installer will guide you through a quick and secure setup.\n"
"\n"
"Super + Alt + S turns the screen reader on or off.\n"
"\n"
"Let's begin!\n"
msgstr ""
"Shani OS मध्ये तुमचे स्वागत आहे!\n"
"\n"
"विश्वासार्हतेसाठी बनलेली, न बिघडणारी सिस्टम\n"
"\n"
"हा इंस्टॉलर तुम्हाला जलद आणि सुरक्षित सेटअप करून देईल.\n"
"\n"
"Super + Alt + S ने स्क्रीन रीडर चालू किंवा बंद होतो.\n"
"\n"
"चला, सुरुवात करूया!\n"
