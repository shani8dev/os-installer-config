# Hindi translation of the Shani OS installer configuration.
msgid ""
msgstr ""
"Project-Id-Version: os-installer-config\n"
"Language: hi\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid ""
"Welcome to Shani OS!\n"
"\n"
"An Immutable OS for Ultimate Reliability\n"
"\n"
"This installer will guide you through a quick and secure setup.\n"
"\n"
"Super + Alt + S turns the screen reader on or off.\n"
"\n"
"Let's begin!\n"
msgstr ""
"Shani OS में आपका स्वागत है!\n"
"\n"
"भरोसे के लिए बना, कभी न बिगड़ने वाला सिस्टम\n"
"\n"
"यह इंस्टॉलर आपको जल्दी और सुरक्षित सेटअप कराएगा।\n"
"\n"
"Super + Alt + S से स्क्रीन रीडर चालू या बंद होता है।\n"
"\n"
"चलिए शुरू करते हैं!\n"
